# System Backup Ignore Configuration
# Gitignore-style patterns for rsync --exclude-from (see docs/backup-principles.md
# for the principles behind every rule and the exact pattern semantics).
#
# Principle: the system is backed up for RECOVERABILITY, not preservation.
# Keep what a bare restore needs to boot into a working machine; exclude
# everything rebuildable (caches, logs, tmp) and bulk runtime data that is
# exported/handled separately (containers, VMs, databases).

# Virtual filesystems and special directories (never copy these)
/proc/*
/proc/.*
/sys/*
/sys/.*
/dev/*
/dev/.*
/run/*
/run/.*
/tmp/*
/tmp/.*
/var/tmp/*
/var/tmp/.*
lost+found/

# Non-local filesystems (mount points — backup only real, local data)
/mnt/*
/mnt/*/
/media/*
/media/*/
/net/*
/net/*/

# BTRFS snapshots subvolume, if mounted at root
/.snapshots/
/snapshots/

# Boot/EFI: separate partitions, not part of the root fs — back up the ESP
# separately if needed (kernel/initramfs live in /boot which IS included)
/boot/efi/*
/boot/efi/.*
/efi/*

# Swap files and hibernation
/swapfile
/swap.img
*.swap

# System logs (regenerated; extract what you need to keep, not bulk journals)
/var/log/*.log
/var/log/*.log.*
/var/log/*.gz
/var/log/journal/*
/var/log/audit/*
/var/crash/

# Coredumps (tier 5)
/var/lib/systemd/coredump/*

# Package manager caches (re-downloadable — tier 4)
/var/cache/pacman/pkg/*
/var/cache/apt/archives/*
/var/cache/yum/*
/var/cache/dnf/*
/var/cache/zypper/*
# Everything else under /var/cache (keep the directory, drop contents)
/var/cache/*
/var/cache/.*

# Spool and transient daemon state
/var/spool/*
/var/lib/dhcp/*

# Databases: data dirs are runtime bulk data — dump them separately
# (pg_dump / mysqldump) instead of copying live files (they may be mid-write
# and restore is version-dependent)
/var/lib/mysql/
/var/lib/mariadb/
/var/lib/postgres/
/var/lib/postgresql/
/var/lib/redis/
/var/lib/mongodb/

# Container runtimes: image layers are re-pullable (tier 4); running state is
# exported via podman save / docker commit if it matters
/var/lib/docker/
/var/lib/containerd/
/var/lib/lxc/
/var/lib/containers/storage/
/var/lib/containers/cache/

# Virtualization images — re-create from cloud/install media, or export
# deliberately (virt-clone / qcow2 copy) outside the scheduled backup
/var/lib/libvirt/images/

# Flatpak runtimes and apps (re-install: flatpak install; keep your app list:
# flatpak list --app --columns=application > flatpaks.txt, which IS backed up
# in /root or /var/lib/flatpak-overrides)
/var/lib/flatpak/

# Snap runtime data (snaps are re-downloadable)
/var/lib/snapd/snaps/*
/var/lib/snapd/cache/*
/snap/*/

# Home directory (backed up separately by home-backup.sh)
/home/

# Root user's caches and rebuildable tool state (same rules as home backup)
/root/.cache/
/root/.thumbnails/
/root/.local/share/Trash/
/root/.cargo/registry/
/root/.cargo/git/
/root/.npm/_cacache/
/root/.npm/_npx/
/root/.ollama/
/root/.rustup/
/root/.local/share/mise/installs/
/root/.local/share/mise/downloads/
/root/.local/share/containers/storage/
/root/.config/containers/
/root/.claude/
/root/.gemini/

# Negation note: rsync does NOT re-include inside an excluded directory.
# To keep one file (e.g. a specific log), exclude its siblings or the parent
# directory's other contents instead of  /var/log/  +  !/var/log/important.log
