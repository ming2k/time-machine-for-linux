    {
      "version": "6.0.0",
      "date": "2026-08-25",
      "status": "current",
      "summary": "Protocol v6.0.0 Clean Break: Zero-Vendoring Architecture, Flat Knowledge Topology, in-place Frontmatter lifecycle, and bifurcated invariants (INV-LINT machine layer and INV-AGENT cognitive layer)."
    },
    {
      "version": "5.1.0",
      "date": "2026-08-25",
      "status": "superseded",
      "summary": "Standardize Decision Summary and Primary Invariant column in ADR registry index pattern."
    },
    {
      "version": "5.0.0",
      "date": "2026-08-25",
      "status": "superseded",
      "summary": "Clean-Break Architecture: Universal Semantic Tensor Core (taxonomy, invariants, workflow, style) and pluggable vertical domain entities (ADR, RFC, Living Snapshot, Acceptance, Testing, Postmortem)."
    },
    {
      "version": "4.0.0",
      "date": "2026-08-25",
      "status": "superseded",
      "summary": "Transitional reorganization to spec directory."
    },
    {
      "version": "3.2.0",
      "date": "2026-08-25",
      "status": "superseded",
      "summary": "Enhance Architecture profile with Log vs Snapshot duality, RFC vs ADR separation of concerns, and ADR compaction pattern."
    },
    {
      "version": "3.1.0",
      "date": "2026-08-25",
      "status": "superseded",
      "summary": "Streamline Product Validation profile to dual-tier model (acceptance.md and testing.md)."
    },
    {
      "version": "3.0.0",
      "date": "2026-08-24",
      "status": "superseded",
      "summary": "Modular Governance Architecture: micro-core protocol decoupled from pluggable domain profiles."
    },
    {
      "version": "2.0.0",
      "date": "2026-08-23",
      "status": "superseded",
      "summary": "Three routing gates with root-files exception and manifest for drift detection."
    },
    {
      "version": "1.0.0",
      "date": "2026-06-13",
      "status": "superseded",
      "summary": "Initial flat Diataxis decision list."
    }
  ],
